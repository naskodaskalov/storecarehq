  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Your sign-in link — StoreCare HQ</title>\n<style>@media only screen and (max-width:600px){.outer{padding:20px 12px!important}.content{padding:32px 24px!important}.heading{font-size:30px!important}.brand{padding:26px 24px!important}}</style></head>\n<body style=\"margin:0;padding:0;background-color:#eef3f2;color:#203438;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;font-size:1px;line-height:1px;color:#eef3f2;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">Your secure sign-in link for StoreCare HQ is ready.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"background-color:#eef3f2;\"><tr><td class=\"outer\" align=\"center\" style=\"padding:48px 20px;\">\n<!--[if mso]><table role=\"presentation\" width=\"560\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:560px;border:1px solid #dce6e3;border-radius:16px;overflow:hidden;background-color:#ffffff;\">\n<tr><td class=\"brand\" bgcolor=\"#1d3034\" style=\"padding:30px 40px;background-color:#1d3034;border-radius:15px 15px 0 0;\">\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td width=\"38\" height=\"36\" align=\"center\" style=\"border:2px solid #93d3c5;border-radius:9px;color:#a9e0d3;font-size:14px;font-weight:bold;letter-spacing:-1px;\">SC</td><td style=\"padding-left:12px;font-size:21px;letter-spacing:-0.7px;font-weight:bold;color:#ffffff;\">StoreCare HQ</td></tr></table>\n<p style=\"margin:23px 0 0;font-size:12px;line-height:19px;color:#b9d1cd;\">Behind every thriving store is a team that cares.</p></td></tr>\n<tr><td class=\"content\" style=\"padding:40px;\">\n<p style=\"margin:0 0 14px;color:#087f75;font-size:11px;line-height:16px;font-weight:bold;letter-spacing:1.6px;\">YOUR AGENCY WORKSPACE</p>\n<h1 class=\"heading\" style=\"margin:0 0 14px;color:#1d3034;font-size:34px;line-height:1.15;letter-spacing:-1px;font-weight:bold;\">Your stores are waiting.</h1>\n<p style=\"margin:0 0 18px;font-size:17px;line-height:26px;color:#314c50;\">A clear view. A little peace of mind.</p>\n<p style=\"margin:0 0 28px;font-size:15px;line-height:25px;color:#596f72;\">Here’s the secure sign-in link you requested. Use it to return to your StoreCare HQ workspace and pick up where you left off.</p>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td align=\"center\" bgcolor=\"#087f75\" style=\"border-radius:7px;background-color:#087f75;mso-padding-alt:16px 26px;\">\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:16px 26px;border:1px solid #087f75;border-radius:7px;font-size:15px;line-height:20px;font-weight:bold;color:#ffffff;text-decoration:none;\">Sign in to StoreCare</a></td></tr></table>\n<p style=\"margin:16px 0 28px;font-size:12px;line-height:20px;color:#687e80;\">This link can be used once. Open it in the same browser where you requested it.</p>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td bgcolor=\"#f0f7f5\" style=\"padding:16px 18px;border-left:3px solid #99cdbf;background-color:#f0f7f5;font-size:13px;line-height:21px;color:#3f6260;\">Prefer using a password? You can set one from your workspace after signing in.</td></tr></table>\n<p style=\"margin:28px 0 10px;font-size:12px;line-height:20px;color:#687e80;\">Button not working? Copy and paste this link into your browser:</p>\n<p style=\"margin:0;font-size:11px;line-height:18px;word-break:break-all;overflow-wrap:anywhere;\"><a href=\"{{ .ConfirmationURL }}\" style=\"color:#087f75;text-decoration:underline;word-break:break-all;\">{{ .ConfirmationURL }}</a></p>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td style=\"padding-top:28px;\"><div style=\"border-top:1px solid #e0e8e5;height:1px;font-size:1px;line-height:1px;\">&nbsp;</div></td></tr></table>\n<p style=\"margin:22px 0 0;font-size:12px;line-height:20px;color:#687e80;\">Didn’t request a sign-in link? You can safely ignore this email.</p>\n</td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n<p style=\"max-width:500px;margin:24px 0 0;font-size:11px;line-height:19px;color:#718581;\">StoreCare HQ &nbsp;·&nbsp; Care made visible.<br>This is an automated account email. Please don’t reply.</p>\n</td></tr></table></body></html>\n"
