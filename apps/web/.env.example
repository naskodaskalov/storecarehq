# Supabase project settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_…) or the legacy anon key. Both are public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set STORECARE_DEMO=1 to run with in-memory sample data instead of Supabase.
# App origin, used in auth, billing and report links. Production: https://app.storecarehq.com
# Public marketing website: https://www.storecarehq.com (separate host, same deployment).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Billing (Stripe). Test mode keys while trying it out. Without them the billing page shows plans but can't sell.
STRIPE_SECRET_KEY=
# From the webhook endpoint you add in Stripe (…/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Supabase project settings → API Keys → secret key. Server-only: writes plan and billing fields.
SUPABASE_SERVICE_ROLE_KEY=
# Hosted outreach report links, the outreach history and the admin overview also require this server-only key
# and their migrations (outreach_report_links, outreach_contacts, admin_metrics). Browser roles cannot read these.

# Contact form delivery (landing site and /contact in the app).
RESEND_API_KEY=
# Requested agency reports: sender must be on a Resend-verified domain.
# Recipient is the CSV contact_email; replies go to the signed-in admin address.
# Use Resend only for agencies that requested the report or explicitly opted in.
OUTREACH_FROM=StoreCare HQ <support@storecarehq.com>
# Where prospects' replies to outreach emails go. Empty: the signed-in admin's own email.
OUTREACH_REPLY_TO=support@storecarehq.com
# Your receiving inbox. Required; never taken from the visitor's form.
CONTACT_TO=
# A sender on a domain verified in Resend. Falls back to REPORTS_FROM if configured.
CONTACT_FROM=
# Optional: require ?token=… on /api/health/monitoring (the URL your external uptime monitor polls).
MONITORING_STATUS_TOKEN=
# Set to 1 once Stripe Managed Payments is active on the account (Stripe becomes merchant of record and handles VAT).
STRIPE_MANAGED_PAYMENTS=
# Admin tools (/admin overview, quick report and outreach): comma-separated emails of StoreCare staff. Leave empty for no admins.
STORECARE_ADMIN_EMAILS=
# Time zone the admin overview counts "today" in and shows times in (IANA name). Default: Europe/Sofia.
STORECARE_ADMIN_TIMEZONE=
# Optional: adds a mobile PageSpeed test to the admin quick report (same key the worker uses).
PAGESPEED_API_KEY=
# Google Analytics 4 measurement ID (G-…) for the public website. Loads only after the visitor accepts the cookie banner.
NEXT_PUBLIC_GA_ID=
# Optional: Google Search Console HTML-tag verification code (the content="…" value). Not needed with DNS verification.
GOOGLE_SITE_VERIFICATION=
