# Supabase project settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_…) or the legacy anon key. Both are public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set STORECARE_DEMO=1 to run with in-memory sample data instead of Supabase.
# Public URL of this app, used in magic-link redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
