# Supabase → Project settings → Database → Connection string (session pooler, port 5432).
# The worker connects as the postgres role, so it bypasses RLS by design.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Google Cloud → APIs → PageSpeed Insights API → credentials (free; needed, the shared quota is always exhausted)
PAGESPEED_API_KEY=
# resend.com → API keys
RESEND_API_KEY=
ALERTS_FROM=StoreCare HQ <alerts@storecarehq.com>
# Used in alert links. Production: https://app.storecarehq.com
APP_URL=http://localhost:3000

# Optional: AI-written summaries for reports drafted on the 1st
ANTHROPIC_API_KEY=
